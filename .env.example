# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/events-platform

# JWT Configuration
JWT_ACCESS_SECRET=your-access-token-secret-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-refresh-token-secret-key-change-in-production-min-32-chars
JWT_ACCESS_EXPIRY=15m
# Refresh token TTL when rememberMe=false (and OAuth remember_me=false)
JWT_REFRESH_EXPIRY=7d
# Refresh token TTL when rememberMe=true (and OAuth remember_me=true)
JWT_REFRESH_EXPIRY_LONG=30d

# Password reset token TTL (opaque token hashed in DB)
PASSWORD_RESET_TOKEN_EXPIRY=1h

# OAuth: one-time exchange code TTL (seconds); CSRF state TTL (minutes)
OAUTH_EXCHANGE_CODE_TTL_SEC=60
OAUTH_STATE_TTL_MIN=10

# Google OAuth (Authorization Code on server). In Google Cloud, redirect URI = backend only:
# e.g. http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Comma-separated allowed origins for ?redirect_uri= on GET /api/auth/google (frontend URLs).
# Defaults to FRONTEND_URL origin if unset.
# FRONTEND_OAUTH_REDIRECT_ORIGINS=http://localhost:3000,https://app.example.com

# Frontend base URL (password reset links, OAuth error fallback)
FRONTEND_URL=http://localhost:3000
FRONTEND_SUCCESS_URL=http://localhost:3000/
FRONTEND_FAILURE_URL=http://localhost:3000/

# CORS Configuration (comma-separated origins)
CORS_ORIGIN=http://localhost:3000

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# Bcrypt Configuration
BCRYPT_SALT_ROUNDS=10

# Logging Configuration
LOG_LEVEL=info

# Email (Resend) — required to actually send password reset / transactional mail
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@example.com
